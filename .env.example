# Domain name mà n8n sẽ truy cập được
# Ban đầu đặt là IP public. Sử dụng /root/changedomain.sh để cập nhật.

DEPLOY_FOLDER=/home/n8n-deploy

DOMAIN_NAME=

# If not set New York time will be used
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# Log rotation
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3

N8N_ENCRYPTION_KEY=

# Nên pin bằng đúng tag của n8n đang chạy trước khi docker compose up -d.
N8N_IMAGE=n8nio/n8n:1.123.11

# Generate Video
# Có thể đổi model tạo prompt nếu cần.
OPENAI_PROMPT_MODEL=gpt-4.1-mini
# Dùng thư mục lưu trữ bền vững khi chạy Docker/production.
VIDEO_OUTPUT_DIR=./generated-videos
# GeminiGen trả status=2 khi xong, status=3 khi thất bại.
GEMINIGEN_POLL_SECONDS=30
GEMINIGEN_MAX_POLLS=20
